# SQLite by default. Example for PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/portfolio
DATABASE_URL=sqlite:///./portfolio.db

# Comma separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Regex for additional allowed origins. Defaults to any *.vercel.app domain.
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
